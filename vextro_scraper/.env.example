# Secure delivery into the VEXTRO backend. The ingestion key has no default
# so a crawl cannot deliver data without explicit authentication.
VEXTRO_API_URL=http://127.0.0.1:8000
INGESTION_API_KEY=
VEXTRO_API_TIMEOUT=5
VEXTRO_INGESTION_BATCH_SIZE=25

# Written onto every scrape run record: manual | scheduler | test
VEXTRO_SCRAPE_TRIGGER=manual

# Review collection bounds
MAX_REVIEWS_PER_LISTING=50
DARAZ_REVIEWS_ENABLED=true
MAX_REVIEW_LISTINGS_PER_RUN=150

# Scheduler (see vextro_scraper/scheduler.py)
SCRAPER_ENABLED=true
SCRAPER_RUN_ON_STARTUP=true
SCRAPER_INTERVAL_HOURS=12
SCRAPER_SPIDERS=priceoye_smartphones,daraz_smartphones
# SCRAPER_LOCK_PATH=.runtime/scraper-scheduler.lock
