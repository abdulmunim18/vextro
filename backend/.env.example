APP_NAME=VEXTRO API
APP_VERSION=0.1.0
APP_DEBUG=true

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=vextro_db
DB_USER=vextro_app
DB_PASSWORD=replace_with_local_password
DB_ECHO=false

JWT_SECRET_KEY=replace-with-a-secure-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
EMAIL_OTP_EXPIRE_MINUTES=10
EMAIL_OTP_RESEND_COOLDOWN_SECONDS=60
EMAIL_OTP_MAX_ATTEMPTS=5
PASSWORD_RESET_EXPIRE_MINUTES=30


TEST_DB_NAME=vextro_test_db

INGESTION_API_KEY=replace_with_a_secure_ingestion_key
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend base URL used to build links inside notification emails.
FRONTEND_BASE_URL=http://localhost:5173
API_PUBLIC_BASE_URL=http://localhost:8000

# Social sign-in. Register these exact callback URLs with each provider:
# http://localhost:8000/api/v1/auth/oauth/google/callback
# http://localhost:8000/api/v1/auth/oauth/facebook/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
FACEBOOK_OAUTH_CLIENT_ID=
FACEBOOK_OAUTH_CLIENT_SECRET=

# Email notifications (module 6.14).
# Leave SMTP_HOST empty to disable email delivery entirely; notification
# events are then recorded with the email channel marked "skipped".
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=VEXTRO
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=15

# Browser Web Push notifications (module 6.14).
# Generate a pair with: python -m scripts.generate_vapid_keys
# Never commit the private key.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Bounded retry budget for email and Web Push delivery attempts.
NOTIFICATION_DELIVERY_MAX_ATTEMPTS=3

# Scheduled digest reports (module 6.14).
# DIGEST_WEEKLY_DAY uses 0=Monday through 6=Sunday.
DIGEST_TIMEZONE=Asia/Karachi
DIGEST_DAILY_HOUR=8
DIGEST_WEEKLY_DAY=0
DIGEST_WEEKLY_HOUR=9
DIGEST_ATTACH_SME_REPORT=true

# Enable the in-process scheduler in exactly one API process, or leave it
# false and drive the jobs with cron:
#   python -m scripts.run_notification_jobs daily-digest
DIGEST_SCHEDULER_ENABLED=false
NOTIFICATION_OUTBOX_INTERVAL_SECONDS=300
